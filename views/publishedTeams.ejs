<%- include("partials/header") %>
<%- include("partials/nav") %>

<h1>Published Teams</h1>

<% publishedTeams.forEach(team => { %>
    <div class="shared-card">

        <h3>
            <%= team.teamName %>
        </h3>

        <p>
            Trainer:
            <%= team.trainerName %>
        </p>

        <div class="shared-pokemon">
            <% team.pokemon.forEach(pokemon => { %>
                <div class="shared-pokemon-card">
                    <img
                        src="<%= pokemon.pokemonImage %>"
                        alt="<%= pokemon.pokemonName %>">

                    <p>
                        <%= pokemon.pokemonName %>
                    </p>
                </div>
            <% }) %>
        </div>
    </div>
<% }) %>

<%- include("partials/footer") %>