<%- include("partials/header") %>
<%- include("partials/nav") %>

<h1>Published Teams</h1>

<ul>
    <% publishedTeams.forEach(team => { %>
        <h3>
            <%= team.teamName %>
        </h3>
        <P>
            Trainer:
            <%= team.trainerName %>
        </P>
        <ul>
            <% team.pokemon.forEach(pokemon => { %>
                <li>
                    <%= pokemon %>
                </li>
            <% }) %>
        </ul>
    <% }) %>
</ul>

<%- include("partials/footer") %>