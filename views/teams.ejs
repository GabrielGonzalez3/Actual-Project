<%- include("partials/header") %>
<%- include("partials/nav") %>

<h1>Team Management</h1>

<form action="/teams" method="POST">
    <label for="trainerId">
        Trainer
    </label>

    <select
        id="trainerId"
        name="trainerId"
        required
    >
        <% trainers.forEach(trainer => { %>
            <option value="<%= trainer.id %>">
                <%= trainer.trainerName %>
            </option>
        <% }) %>
    </select>

    <br><br>
    <label for="teamName">
        Team Name
    </label>

    <input
        type="text"
        id="teamName"
        name="teamName"
        required
    >
    <button type="submit">
        Create Team
    </button>
</form>

<hr>

<h2>Add Pokemon To Team</h2>

<form action="/teams/pokemon" method="POST">
    <label>
        Team
    </label>

    <select name="teamId">
        <% teams.forEach(team => { %>
            <option value="<%= team.id %>">
                <%= team.teamName %>
            </option>
        <% }) %>
    </select>

    <br><br>

    <label>
        Pokemon
    </label>

    <select name="pokemonId">
        <% pokemon.forEach(pokey => { %>
            <option value="<%= pokey.id %>">
                <%= pokey.pokemonName %>
            </option>
        <% }) %>
    </select>
    <br><br>
    
    <button type="submit">
        Add Pokemon
    </button>

</form>

<h2>Teams</h2>

<ul>
    <% teamDetails.forEach(team => { %>
        <li>
            Team Name:
            <%= team.teamName %>
            |
            Trainer:
            <%= team.trainerName %>
        </li>
        <form
            action="/teams/publish/<%= team.id %>"
            method="POST"
            style="display:inline;"
        >
                <button type="submit">
                Publish Team
            </button>
        </form>
    <% }) %>
</ul>

<h2>Team Members</h2>

<ul>
    <% teamMemberDetails.forEach(member => {%>
        <li>
            ID:
            <%= member.id %>

            Team Name:
            <%= member.teamName %>
            |
            Pokemon Name:
            <%= member.pokemonName %>

            <form
                action="/teams/pokemon/remove/<%= member.id %>"
                method="POST"
                style="display:inline;"
            >
                <button type="submit">
                    Remove
                </button>
            </form>
        </li>
    <% }) %>
</ul>

<%- include("partials/footer") %>